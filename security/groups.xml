<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════
         AP RECONCILIATION SECURITY GROUPS
    ══════════════════════════════════════════════════════════ -->

    <record id="module_ap_reconciliation" model="ir.module.category">
        <field name="name">Afghan Post Reconciliation</field>
        <field name="description">Manage access to Afghan Post Reconciliation module</field>
        <field name="sequence">100</field>
    </record>

    <record id="group_ap_reconciliation_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_ap_reconciliation"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can view and create reconciliations</field>
    </record>

    <record id="group_ap_reconciliation_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_ap_reconciliation"/>
        <field name="implied_ids" eval="[(4, ref('group_ap_reconciliation_user'))]"/>
        <field name="comment">Full access including delete and export</field>
    </record>

</odoo>
