<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════
         MANUAL RECONCILIATION RESULTS — tree only, no invoice link
    ══════════════════════════════════════════════════════════ -->

    <record id="view_fin_manual_recon_results_tree" model="ir.ui.view">
        <field name="name">fin.manual.reconciliation.line.results.tree</field>
        <field name="model">fin.manual.reconciliation.line</field>
        <field name="arch" type="xml">
            <tree string="Manual Reconciliation Results"
                  decoration-danger="amount_mismatch == True"
                  decoration-warning="found_in_b == False"
                  decoration-success="found_in_b == True and amount_mismatch == False"
                  create="false" delete="false" edit="false">
                <field name="reconciliation_id"  string="Reconciliation"/>
                <field name="invoice_number"     string="Invoice #"/>
                <field name="a_customer"         string="Customer"/>
                <field name="a_date"             string="Date"/>
                <field name="a_total"            string="Total"/>
                <field name="a_bank_acc_no"      string="Bank Name"/>
                <field name="a_transaction_id"   string="Transaction ID"/>
                <field name="found_in_b"         string="In HesabPay" widget="boolean_toggle"/>

                <field name="b_customer"         string="HP Customer"/>
                <field name="b_date"             string="HP Date"/>
                <field name="b_total"            string="HP Total"
                       decoration-danger="amount_mismatch == True"/>
                <field name="b_bank_acc_no"      string="HP Bank Name"/>
                <field name="b_transaction_id"   string="HP Transaction ID"/>
                <field name="amount_difference"  string="Difference"
                       decoration-danger="amount_mismatch == True"
                       decoration-success="amount_mismatch == False and found_in_b == True"/>
                <field name="amount_mismatch"    column_invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════
         SEARCH VIEW — filters and group-by
    ══════════════════════════════════════════════════════════ -->

    <record id="view_fin_manual_recon_results_search" model="ir.ui.view">
        <field name="name">fin.manual.reconciliation.line.results.search</field>
        <field name="model">fin.manual.reconciliation.line</field>
        <field name="arch" type="xml">
            <search string="Search Manual Reconciliation Results">

                <!-- Search fields -->
                <field name="invoice_number"     string="Invoice #"/>
                <field name="a_customer"         string="Customer"/>
                <field name="reconciliation_id"  string="Reconciliation"/>

                <!-- Filters -->
                <filter name="filter_mismatch"
                        string="Mismatches"
                        domain="[('amount_mismatch','=',True)]"/>
                <filter name="filter_not_found"
                        string="Not Found in HesabPay"
                        domain="[('found_in_b','=',False)]"/>
                <filter name="filter_amount_mismatch"
                        string="Amount Mismatch"
                        domain="[('amount_mismatch','=',True)]"/>

                <filter name="filter_today"
                        string="Today"
                        domain="[('a_date','=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="filter_this_week"
                        string="This Week"
                        domain="[('a_date','&gt;=', (context_today() - relativedelta(days=context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                <filter name="filter_this_month"
                        string="This Month"
                        domain="[('a_date','&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <filter name="filter_this_year"
                        string="This Year"
                        domain="[('a_date','&gt;=', context_today().strftime('%Y-01-01'))]"/>

                <!-- Group By -->
                <group expand="0" string="Group By">
                    <filter name="group_reconciliation"
                            string="Reconciliation"
                            context="{'group_by': 'reconciliation_id'}"/>
                    <filter name="group_customer"
                            string="Customer"
                            context="{'group_by': 'a_customer'}"/>
                    <filter name="group_date_day"
                            string="Date: Day"
                            context="{'group_by': 'a_date:day'}"/>
                    <filter name="group_date_week"
                            string="Date: Week"
                            context="{'group_by': 'a_date:week'}"/>
                    <filter name="group_date_month"
                            string="Date: Month"
                            context="{'group_by': 'a_date:month'}"/>
                    <filter name="group_date_year"
                            string="Date: Year"
                            context="{'group_by': 'a_date:year'}"/>
                </group>

            </search>
        </field>
    </record>


    <!-- ══════════════════════════════════════════════════════════
         READ-ONLY FORM POPUP — manual reconciliation line detail
    ══════════════════════════════════════════════════════════ -->

    <record id="view_fin_manual_recon_results_form" model="ir.ui.view">
        <field name="name">fin.manual.reconciliation.line.results.form</field>
        <field name="model">fin.manual.reconciliation.line</field>
        <field name="arch" type="xml">
            <form string="Manual Reconciliation Result Detail" create="false" edit="false" delete="false">
                <sheet>
                    <group string="Afghan Post Details">
                        <group>
                            <field name="reconciliation_id" string="Reconciliation" readonly="1"/>
                            <field name="invoice_number"    string="Invoice #"      readonly="1"/>
                            <field name="a_customer"        string="Customer"       readonly="1"/>
                            <field name="a_date"            string="Date"           readonly="1"/>
                            <field name="a_total"           string="Total"          readonly="1"/>
                            <field name="a_bank_acc_no"         string="Bank Name"        readonly="1"/>
                            <field name="a_transaction_id"  string="Transaction ID" readonly="1"/>
                        </group>
                    </group>
                    <group string="HesabPay Details">
                        <group>
                            <field name="found_in_b"        string="Found in HesabPay" readonly="1"/>
                            <field name="b_customer"        string="HP Customer"    readonly="1"/>
                            <field name="b_date"            string="HP Date"        readonly="1"/>
                            <field name="b_total"           string="HP Total"       readonly="1"/>
                            <field name="b_bank_acc_no"         string="HP Bank Name"     readonly="1"/>
                            <field name="b_transaction_id"  string="HP Transaction ID" readonly="1"/>
                        </group>
                        <group>
                            <field name="amount_difference" string="Difference"     readonly="1"/>
                            <field name="amount_mismatch"   string="Amount Mismatch" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════
         WINDOW ACTION — tree only, no form view
    ══════════════════════════════════════════════════════════ -->

    <record id="action_fin_manual_recon_results" model="ir.actions.act_window">
        <field name="name">Manual Reconciliation Results</field>
        <field name="res_model">fin.manual.reconciliation.line</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_fin_manual_recon_results_tree"/>
        <field name="search_view_id" ref="view_fin_manual_recon_results_search"/>
        <field name="domain">[]</field>
        <field name="context">{
            'search_default_filter_mismatch': 1
        }</field>
        <field name="groups_id" eval="[(4, ref('ap_reconciliation.group_manual_recon_officer'))]"/>
    </record>

</odoo>
