<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_financial_reconciliation" model="ir.module.category">
        <field name="name">Financial Reconciliation</field>
        <field name="description">Manage access to Financial Reconciliation module</field>
        <field name="sequence">100</field>
    </record>

    <!-- User: can create and see only their own records, cannot delete -->
    <record id="group_fin_recon_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_financial_reconciliation"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can create reconciliations and view only their own records. Cannot delete.</field>
    </record>

    <!-- Manager: full access to all records -->
    <record id="group_fin_recon_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_financial_reconciliation"/>
        <field name="implied_ids" eval="[(4, ref('group_fin_recon_user'))]"/>
        <field name="comment">Full access to all reconciliation records including delete.</field>
    </record>

</odoo>
