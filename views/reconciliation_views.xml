<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════
         STANDALONE TREE — All Lines
    ══════════════════════════════════════════════════════════ -->

    <record id="view_fin_recon_line_all" model="ir.ui.view">
        <field name="name">fin.reconciliation.line.tree.all</field>
        <field name="model">fin.reconciliation.line</field>
        <field name="arch" type="xml">
            <tree decoration-danger="name_mismatch == True or amount_mismatch == True"
                  decoration-warning="hp_found == False"
                  decoration-success="hp_found == True and name_mismatch == False and amount_mismatch == False"
                  create="false" delete="false" edit="false">
                <field name="invoice_number"    string="Invoice #"/>
                <field name="partner_name"      string="Customer"/>
                <field name="invoice_date"      string="Date"/>
                <field name="total_amount"      string="Total"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>
                <field name="currency_id"       column_invisible="1"/>
                <field name="status"            string="Status"/>
                <field name="payment_state"     string="Payment"/>
                <field name="hp_found"          string="In HesabPay" widget="boolean_toggle"/>
                <field name="hp_partner_name"   string="HP Customer"
                       decoration-danger="name_mismatch == True"/>
                <field name="hp_invoice_date"   string="HP Date"/>
                <field name="hp_total_amount"   string="HP Total"
                       decoration-danger="amount_mismatch == True"/>
                <field name="amount_difference" string="Difference"
                       decoration-danger="amount_mismatch == True"
                       decoration-success="amount_mismatch == False and hp_found == True"/>
                <field name="name_mismatch"     column_invisible="1"/>
                <field name="amount_mismatch"   column_invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════
         STANDALONE TREE — Mismatches Only
    ══════════════════════════════════════════════════════════ -->

    <record id="view_fin_recon_line_mismatch" model="ir.ui.view">
        <field name="name">fin.reconciliation.line.tree.mismatch</field>
        <field name="model">fin.reconciliation.line</field>
        <field name="arch" type="xml">
            <tree decoration-danger="name_mismatch == True or amount_mismatch == True"
                  decoration-warning="hp_found == False"
                  create="false" delete="false" edit="false">
                <field name="invoice_number"    string="Invoice #"/>
                <field name="partner_name"      string="Customer"/>
                <field name="invoice_date"      string="Date"/>
                <field name="total_amount"      string="Total"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>
                <field name="currency_id"       column_invisible="1"/>
                <field name="hp_partner_name"   string="HP Customer"
                       decoration-danger="name_mismatch == True"/>
                <field name="hp_invoice_date"   string="HP Date"/>
                <field name="hp_total_amount"   string="HP Total"
                       decoration-danger="amount_mismatch == True"/>
                <field name="amount_difference" string="Difference"
                       decoration-danger="amount_mismatch == True"/>
                <field name="hp_found"          column_invisible="1"/>
                <field name="name_mismatch"     column_invisible="1"/>
                <field name="amount_mismatch"   column_invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════
         FORM VIEW
    ══════════════════════════════════════════════════════════ -->

    <record id="view_fin_reconciliation_form" model="ir.ui.view">
        <field name="name">fin.reconciliation.form</field>
        <field name="model">fin.reconciliation</field>
        <field name="arch" type="xml">
            <form string="Financial Reconciliation" class="o_ap_reconciliation">

                <header>
                    <!-- Primary action buttons in header -->
                    <button name="action_load_data"
                            string="Load Invoices"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_import_excel"
                            string="Compare Records"
                            type="object"
                            class="btn-primary"
                            invisible="state == 'draft'"/>
                    <button name="action_export_report"
                            string="Export Report"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'reconciled'"/>
                    <button name="action_reset"
                            string="Reset"
                            type="object"
                            class="btn-secondary"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,loaded,reconciled"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Reconciliation Reference"/>
                        <h1>
                            <field name="name" placeholder="e.g. January 2026 Reconciliation"/>
                        </h1>
                        <div class="o_recon_meta" invisible="state == 'draft'">
                            <span>Created by: <field name="create_uid" readonly="1"/></span>
                            <span style="margin-left:16px;">Created: <field name="create_date" readonly="1"/></span>
                            <span style="margin-left:16px;">Updated: <field name="write_date" readonly="1"/></span>
                        </div>
                    </div>

                    <!-- Summary badges -->
                    <div class="o_recon_summary" invisible="state != 'reconciled'">
                        <span class="o_recon_badge o_recon_total">
                            Total: <field name="total_lines" readonly="1"/>
                        </span>
                        <span class="o_recon_badge o_recon_ok">
                            ✔ Matched: <field name="matched_lines" readonly="1"/>
                        </span>
                        <span class="o_recon_badge o_recon_mismatch">
                            ✗ Mismatch: <field name="mismatch_lines" readonly="1"/>
                        </span>
                        <span class="o_recon_badge o_recon_notfound">
                            ? Not Found: <field name="not_found_lines" readonly="1"/>
                        </span>
                    </div>

                    <!-- FILTERS -->
                    <group string="Step 1 — Filters">
                        <group>
                            <field name="date_filter" widget="radio"
                                   options="{'horizontal': true}"/>
                            <field name="date_from"
                                   invisible="date_filter != 'custom'"
                                   required="date_filter == 'custom'"/>
                            <field name="date_to"
                                   invisible="date_filter != 'custom'"
                                   required="date_filter == 'custom'"/>
                        </group>
                        <group>
                            <field name="journal_ids" widget="many2many_tags"
                                   options="{'no_create': True}"
                                   placeholder="All journals (leave empty for all)"/>
                            <field name="invoice_number_filter"
                                   placeholder="e.g. mofa, MOhe, 260101 (leave empty for all)"/>
                        </group>
                    </group>

                    <!-- UPLOAD -->
                    <group string="Step 2 — Import HesabPay File"
                           invisible="state == 'draft'">
                        <group>
                            <field name="excel_file" widget="binary"
                                   filename="excel_filename"
                                   string="Upload HesabPay Excel (.xlsx)"/>
                            <field name="excel_filename" invisible="1"/>
                        </group>
                    </group>

                    <!-- LEGEND -->
                    <div class="o_recon_legend" invisible="state != 'reconciled'">
                        <span class="o_recon_legend_item o_recon_ok">■ Matched</span>
                        <span class="o_recon_legend_item o_recon_mismatch">■ Mismatch</span>
                        <span class="o_recon_legend_item o_recon_notfound">■ Not Found</span>
                    </div>

                    <notebook invisible="state == 'draft'">
                        <page string="All Lines">
                            <field name="line_ids"
                                   readonly="1"
                                   nolabel="1"
                                   context="{'list_view_ref': 'ap_reconciliation.view_fin_recon_line_all'}"/>
                        </page>
                        <page string="Mismatches Only">
                            <field name="mismatch_line_ids"
                                   readonly="1"
                                   nolabel="1"
                                   context="{'list_view_ref': 'ap_reconciliation.view_fin_recon_line_mismatch'}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════
         LIST VIEW
    ══════════════════════════════════════════════════════════ -->

    <record id="view_fin_reconciliation_list" model="ir.ui.view">
        <field name="name">fin.reconciliation.list</field>
        <field name="model">fin.reconciliation</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"            string="Reference"/>
                <field name="create_uid"      string="Created By"/>
                <field name="date_filter"     string="Period"/>
                <field name="date_from"       string="From"/>
                <field name="date_to"         string="To"/>
                <field name="total_lines"     string="Total"/>
                <field name="matched_lines"   string="Matched"/>
                <field name="mismatch_lines"  string="Mismatches"/>
                <field name="not_found_lines" string="Not Found"/>
                <field name="create_date"     string="Created"/>
                <field name="state"           widget="badge"/>
            </tree>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════
         SEARCH VIEW
    ══════════════════════════════════════════════════════════ -->

    <record id="view_fin_reconciliation_search" model="ir.ui.view">
        <field name="name">fin.reconciliation.search</field>
        <field name="model">fin.reconciliation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="create_uid"/>
                <filter name="my_records" string="My Records"
                        domain="[('create_uid','=',uid)]"/>
                <filter name="reconciled" string="Reconciled"
                        domain="[('state','=','reconciled')]"/>
                <filter name="loaded" string="Loaded"
                        domain="[('state','=','loaded')]"/>
                <filter name="draft" string="Draft"
                        domain="[('state','=','draft')]"/>
            </search>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════
         RECORD RULES
    ══════════════════════════════════════════════════════════ -->

    <!-- Users see only their own records -->
    <record id="rule_fin_recon_user_own" model="ir.rule">
        <field name="name">Financial Reconciliation: Users see own records</field>
        <field name="model_id" search="[(&quot;model&quot;,&quot;=&quot;,&quot;fin.reconciliation&quot;)]"/>
        <field name="domain_force">[('create_uid','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('ap_reconciliation.group_fin_recon_user'))]"/>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Managers see all records — no restriction -->
    <record id="rule_fin_recon_manager_all" model="ir.rule">
        <field name="name">Financial Reconciliation: Managers see all records</field>
        <field name="model_id" search="[(&quot;model&quot;,&quot;=&quot;,&quot;fin.reconciliation&quot;)]"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('ap_reconciliation.group_fin_recon_manager'))]"/>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- ══════════════════════════════════════════════════════════
         WINDOW ACTION
    ══════════════════════════════════════════════════════════ -->

    <record id="action_fin_reconciliation" model="ir.actions.act_window">
        <field name="name">AP Reconciliation</field>
        <field name="res_model">fin.reconciliation</field>
        <field name="view_mode">tree,form</field>
        <field name="target">current</field>
        <field name="context">{'default_date_filter': 'this_month'}</field>
        <field name="groups_id" eval="[(4, ref('ap_reconciliation.group_fin_recon_user'))]"/>
    </record>

</odoo>
