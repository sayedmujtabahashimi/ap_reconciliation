<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_financial_reconciliation" model="ir.module.category">
        <field name="name">Financial Reconciliation</field>
        <field name="description">Manage access to Financial Reconciliation module</field>
        <field name="sequence">100</field>
    </record>

    <!-- ROLE 1: Reconciliation User — AP Reconciliation only, own records, no delete -->
    <record id="group_recon_officer" model="res.groups">
        <field name="name">Reconciliation User</field>
        <field name="category_id" ref="module_financial_reconciliation"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Access to AP Reconciliation only. Own records, no delete.</field>
    </record>

    <!-- ROLE 2: Manual Reconciliation User — Manual Reconciliation only, own records, no delete -->
    <record id="group_manual_recon_officer" model="res.groups">
        <field name="name">Manual Reconciliation User</field>
        <field name="category_id" ref="module_financial_reconciliation"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Access to Manual Reconciliation only. Own records, no delete.</field>
    </record>

    <!-- ROLE 3: Manager — full access to all records in both menus, including delete -->
    <record id="group_fin_recon_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_financial_reconciliation"/>
        <field name="implied_ids" eval="[
            (4, ref('group_recon_officer')),
            (4, ref('group_manual_recon_officer')),
        ]"/>
        <field name="comment">Full access to all records in both menus including delete.</field>
    </record>

</odoo>
