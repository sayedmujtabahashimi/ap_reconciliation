<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        KEY RULE in Odoo 17:
        Any <tree> written INSIDE a <field> in a form view is validated
        against the PARENT form's model — not the field's comodel.

        SOLUTION: Never write <tree> inside the form at all.
        1. Declare standalone ir.ui.view records for the line model.
        2. In the form, reference them only via context list_view_ref.
    -->

    <!-- ══════════════════════════════════════════════════
         STANDALONE LIST VIEW — hesabpay.reconciliation.line
         (All lines)
    ══════════════════════════════════════════════════ -->
    <record id="view_recon_line_list_all" model="ir.ui.view">
        <field name="name">hesabpay.reconciliation.line.list.all</field>
        <field name="model">hesabpay.reconciliation.line</field>
        <field name="arch" type="xml">
            <tree
                decoration-danger="name_mismatch == True or amount_mismatch == True"
                decoration-warning="hp_found == False"
                decoration-success="hp_found == True and name_mismatch == False and amount_mismatch == False"
                create="false" delete="false" edit="false">
                <field name="invoice_number"    string="Invoice #"/>
                <field name="partner_name"      string="Odoo Customer"/>
                <field name="invoice_date"      string="Odoo Date"/>
                <field name="total_amount"      string="Odoo Total"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>
                <field name="currency_id"       column_invisible="1"/>
                <field name="status"            string="Status"/>
                <field name="payment_state"     string="Payment"/>
                <field name="hp_found"          string="In HesabPay" widget="boolean_toggle"/>
                <field name="hp_partner_name"   string="HP Customer"
                       decoration-danger="name_mismatch == True"/>
                <field name="hp_invoice_date"   string="HP Date"/>
                <field name="hp_total_amount"   string="HP Total"
                       decoration-danger="amount_mismatch == True"/>
                <field name="amount_difference" string="Difference (Afs)"
                       decoration-danger="amount_mismatch == True"
                       decoration-success="amount_mismatch == False and hp_found == True"/>
                <field name="name_mismatch"     column_invisible="1"/>
                <field name="amount_mismatch"   column_invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════
         STANDALONE LIST VIEW — hesabpay.reconciliation.line
         (Mismatches only)
    ══════════════════════════════════════════════════ -->
    <record id="view_recon_line_list_mismatch" model="ir.ui.view">
        <field name="name">hesabpay.reconciliation.line.list.mismatch</field>
        <field name="model">hesabpay.reconciliation.line</field>
        <field name="arch" type="xml">
            <tree
                decoration-danger="name_mismatch == True or amount_mismatch == True"
                decoration-warning="hp_found == False"
                create="false" delete="false" edit="false">
                <field name="invoice_number"    string="Invoice #"/>
                <field name="partner_name"      string="Odoo Customer"/>
                <field name="invoice_date"      string="Odoo Date"/>
                <field name="total_amount"      string="Odoo Total"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>
                <field name="currency_id"       column_invisible="1"/>
                <field name="hp_partner_name"   string="HP Customer"
                       decoration-danger="name_mismatch == True"/>
                <field name="hp_invoice_date"   string="HP Date"/>
                <field name="hp_total_amount"   string="HP Total"
                       decoration-danger="amount_mismatch == True"/>
                <field name="amount_difference" string="Difference"
                       decoration-danger="amount_mismatch == True"/>
                <field name="hp_found"          column_invisible="1"/>
                <field name="name_mismatch"     column_invisible="1"/>
                <field name="amount_mismatch"   column_invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════
         MAIN FORM VIEW — hesabpay.reconciliation
         NO <tree> written here. line_ids uses context only.
    ══════════════════════════════════════════════════ -->
    <record id="view_hesabpay_reconciliation_form" model="ir.ui.view">
        <field name="name">hesabpay.reconciliation.form</field>
        <field name="model">hesabpay.reconciliation</field>
        <field name="arch" type="xml">
            <form string="HesabPay Reconciliation" class="o_hesabpay_reconciliation">

                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,loaded,reconciled"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>HesabPay Reconciliation</h1>
                        <p class="text-muted">
                            Compare Odoo invoices with HesabPay bank records
                        </p>
                    </div>

                    <!-- STEP 1: FILTERS -->
                    <group string="Step 1 — Filters">
                        <group>
                            <field name="date_filter" widget="radio"
                                   options="{'horizontal': true}"/>
                            <field name="date_from"
                                   invisible="date_filter != 'custom'"
                                   required="date_filter == 'custom'"/>
                            <field name="date_to"
                                   invisible="date_filter != 'custom'"
                                   required="date_filter == 'custom'"/>
                        </group>
                        <group>
                            <field name="journal_ids" widget="many2many_tags"
                                   options="{'no_create': True}"
                                   placeholder="All journals (leave empty for all)"/>
                        </group>
                    </group>

                    <div class="o_recon_action_row">
                        <button name="action_load_odoo_data"
                                string="🔍  Load Odoo Invoices"
                                type="object"
                                class="btn btn-primary btn-lg o_recon_btn"/>
                    </div>

                    <!-- STEP 2: UPLOAD HESABPAY -->
                    <group string="Step 2 — Import HesabPay File"
                           invisible="state == 'draft'">
                        <group>
                            <field name="excel_file" widget="binary"
                                   filename="excel_filename"
                                   string="Upload HesabPay Excel (.xlsx)"/>
                            <field name="excel_filename" invisible="1"/>
                        </group>
                        <group>
                            <div class="o_recon_hint">
                                <i class="fa fa-info-circle"/> Expected columns:
                                <strong>Number | Customer | Total | Invoice Date</strong>
                            </div>
                        </group>
                    </group>

                    <div class="o_recon_action_row" invisible="state == 'draft'">
                        <button name="action_import_hesabpay"
                                string="📥  Compare with HesabPay"
                                type="object"
                                class="btn btn-warning btn-lg o_recon_btn"/>
                        <button name="action_export_report"
                                string="📊  Export Report"
                                type="object"
                                class="btn btn-success btn-lg o_recon_btn"
                                invisible="state != 'reconciled'"/>
                    </div>

                    <!-- LEGEND -->
                    <div class="o_recon_legend" invisible="state != 'reconciled'">
                        <span class="o_recon_legend_item o_recon_ok">■ Matched</span>
                        <span class="o_recon_legend_item o_recon_mismatch">■ Mismatch</span>
                        <span class="o_recon_legend_item o_recon_notfound">■ Not Found</span>
                    </div>

                    <!--
                        CRITICAL: No <tree> child here.
                        We only set context so Odoo picks up the
                        pre-registered standalone list view for the comodel.
                    -->
                    <notebook invisible="state == 'draft'">

                        <page string="All Lines">
                            <field name="line_ids"
                                   readonly="1"
                                   nolabel="1"
                                   context="{'list_view_ref': 'hesabpay_reconciliation.view_recon_line_list_all'}"/>
                        </page>

                        <page string="Mismatches Only">
                            <field name="mismatch_line_ids"
                                   readonly="1"
                                   nolabel="1"
                                   context="{'list_view_ref': 'hesabpay_reconciliation.view_recon_line_list_mismatch'}"/>
                        </page>

                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════
         WINDOW ACTION
    ══════════════════════════════════════════════════ -->
    <record id="action_hesabpay_reconciliation" model="ir.actions.act_window">
        <field name="name">HesabPay Reconciliation</field>
        <field name="res_model">hesabpay.reconciliation</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'default_date_filter': 'this_month'}</field>
    </record>

</odoo>
